# DeepSeek direct API — the willing runtime brain (offense + orchestration + victim).
# Claude is NOT in the loop. Copy to .env and fill in. (.env is gitignored.)
PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# The Python backend also reads these from ~/exploit-agent/third_party/PIMiner/.env as a
# fallback, so you may leave the key out here if that file has it.

# Optional: point the TS tools at a specific python interpreter.
# PYTHON=python3
